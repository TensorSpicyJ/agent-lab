{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-lab.local/schemas/failure-attribution.schema.json",
  "title": "Physics Benchmark Failure Attribution",
  "type": "object",
  "required": [
    "task_id",
    "run_id",
    "attribution_mode",
    "failed_checks",
    "candidate_causes",
    "probe_tests"
  ],
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "attribution_mode": {
      "type": "string",
      "enum": [
        "deterministic_single_cause",
        "deterministic_multi_candidate",
        "diagnostic_only"
      ]
    },
    "failed_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "check_type",
          "failed_field",
          "observed",
          "expected"
        ],
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "check_type": {
            "type": "string",
            "enum": [
              "schema",
              "algebra",
              "cas_equivalence",
              "numeric",
              "dimension",
              "symmetry",
              "known_limit",
              "source_grounding",
              "assumption_gate",
              "proof_assistant",
              "output_contract"
            ]
          },
          "failed_field": {
            "type": "string",
            "minLength": 1
          },
          "observed": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          }
        }
      }
    },
    "candidate_causes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "cause_id",
          "layer",
          "failure_type",
          "blamed_nodes",
          "evidence",
          "strictness"
        ],
        "additionalProperties": false,
        "properties": {
          "cause_id": {
            "type": "string",
            "pattern": "^C[0-9A-Za-z_-]+$"
          },
          "layer": {
            "type": "string",
            "enum": [
              "physical_premise",
              "formal_translation",
              "assumption_gate",
              "derivation_trace",
              "verification_check",
              "source_grounding",
              "physical_interpretation",
              "output_contract"
            ]
          },
          "failure_type": {
            "type": "string",
            "minLength": 1
          },
          "blamed_nodes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "strictness": {
            "type": "string",
            "enum": [
              "strictly_localized",
              "candidate_only",
              "diagnostic_hypothesis"
            ]
          }
        }
      }
    },
    "probe_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "probe_id",
          "purpose",
          "discriminates_between",
          "test_spec_ref"
        ],
        "additionalProperties": false,
        "properties": {
          "probe_id": {
            "type": "string",
            "pattern": "^PBT[0-9A-Za-z_-]+$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "discriminates_between": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "test_spec_ref": {
            "type": "string",
            "minLength": 1
          },
          "expected_disambiguation": {
            "type": "string"
          }
        }
      }
    }
  }
}
