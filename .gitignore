# Local research content — use templates to generate your own
knowledge/lines/*/
!knowledge/lines/_template/

# Local methodology additions
methodology/experimental/*.md
!methodology/experimental/_template*
methodology/theoretical/*.md
!methodology/theoretical/_template*

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Temporary
*.tmp
*.bak

# Python generated files
__pycache__/
*.py[cod]

# Benchmark run logs can contain verbose local session traces.
benchmarks/**/runs/**/logs/
benchmarks/**/*.log
benchmarks/**/live-status.json
benchmarks/**/live-stage.json
benchmarks/**/*.partial.json
benchmarks/**/INVALID.md
